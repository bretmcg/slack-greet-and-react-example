{
  "display_information": {
    "name": "Greet and React",
    "description": "Says hello when you say hi, and echoes your reactions"
  },
  "features": {
    "bot_user": {
      "display_name": "greetandreact",
      "always_online": true
    }
  },
  "oauth_config": {
    "redirect_urls": [
      "https://YOUR-PUBLIC-URL/slack/oauth_redirect"
    ],
    "scopes": {
      "bot": [
        "channels:history",
        "chat:write",
        "reactions:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://YOUR-PUBLIC-URL/slack/events",
      "bot_events": [
        "message.channels",
        "reaction_added"
      ]
    },
    "org_deploy_enabled": true,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
