# Environment Config
# Copy this file to `.env` and fill in the values from your app's
# "Basic Information" page at https://api.slack.com/apps

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Any random string, e.g. `openssl rand -hex 32`. Signs the OAuth `state`
# parameter, so it must stay the same across restarts and across instances:
# a value that changes mid-install fails the callback with an opaque 400.
SLACK_STATE_SECRET=

# Optional
PORT=3000

# One of: debug, info, warn, error. Anything else falls back to info.
LOG_LEVEL=info

# note: .env is a shell file so there can't be spaces around =
