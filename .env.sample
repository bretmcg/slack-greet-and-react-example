# Environment Config
# Copy this file to `.env` and fill in the values from your app's
# "Basic Information" page at https://api.slack.com/apps

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Any random string. Used to sign the OAuth `state` parameter.
SLACK_STATE_SECRET=

# Optional
PORT=3000
LOG_LEVEL=info

# note: .env is a shell file so there can't be spaces around =
